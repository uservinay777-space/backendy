# PhantomFlow Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR KEYS

# --- LiveKit Realtime Voice Infrastructure ---
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_NAME=phantomflow-room

# --- Sarvam AI Speech Models (Member 2) ---
# Saaras Realtime STT & Bulbul Flash Streaming TTS
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_LANGUAGE_CODE=hi-IN
SARVAM_STT_STREAM_TYPE=fast
SARVAM_STT_MODE=codemix
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_ENDPOINTING=vad
SARVAM_TTS_VOICE_ID=shubh
SARVAM_TTS_MODEL=bulbul:v3

# --- ElevenLabs TTS (Member 2: Primary Text-to-Speech) ---
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default
ELEVENLABS_MODEL=eleven_flash_v2_5


# --- Audio Hardware Settings (Optional) ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION_MS=20
# AUDIO_INPUT_DEVICE_INDEX=0

# --- LLM Provider for Smart Path Reasoning (Member 3) ---
# Can use Sarvam AI (https://api.sarvam.ai/v1 / sarvam-105b-conversations), OpenAI, or Groq
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b-conversations

# --- Hugging Face Datasets (Milestone 5: Lahaja Evaluation) ---
# HF_TOKEN is required for accessing gated AI4Bharat/Lahaja
HF_TOKEN=your_huggingface_access_token

# --- Orchestrator & Fast Lane Settings (Team Lead) ---
LATENCY_TARGET_E2E_MS=800.0
MIDNIGHT_CURSE_TARGET_MS=600.0
FAST_LANE_TIMEOUT_MS=50.0
SMART_PATH_FIRST_TOKEN_TIMEOUT_MS=400.0
LOG_LEVEL=INFO
