# ==========================
# SERVER CONFIGURATION
# ==========================
PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# ==========================
# RAILKIT RAILWAY API
# ==========================
RAILKIT_API_KEY=

# ==========================
# SARVAM AI — PRIMARY TTS
# ==========================
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_SPEAKER=shubh_hi_customer

# ==========================
# ELEVENLABS — OPTIONAL TTS
# ==========================
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ==========================
# TTS PROVIDER
# ==========================
TTS_PROVIDER=sarvam

# ==========================
# LLM / SMART PATH CONFIGURATION
# ==========================
# Supported providers: groq, mock
LLM_PROVIDER=mock
# Groq API Key (get from https://console.groq.com/keys)
# Can also be set as GROQ_API_KEY
LLM_API_KEY=
# Groq model ID (recommended: openai/gpt-oss-120b or llama-3.3-70b-versatile)
LLM_MODEL=openai/gpt-oss-120b
# Request timeout in milliseconds (defaults to 3000ms)
LLM_TIMEOUT_MS=3000
# Generation parameters
LLM_MAX_TOKENS=250
LLM_TEMPERATURE=0.2

# ==========================
# MONGODB ATLAS DATABASE
# ==========================
# Connection string from MongoDB Atlas console:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.llhvlvy.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=phantomflow
